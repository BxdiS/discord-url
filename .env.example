# Секреты. Копируется в .env при первом запуске, .env в git не попадает.
#
# Токен бота: напишите @BotFather в Telegram -> /newbot -> скопируйте токен.
TG_BOT_TOKEN=

# ID чата, куда слать алерты: напишите @userinfobot -> он пришлёт ваш ID.
# Для группы добавьте бота в неё; ID группы начинается с минуса.
TG_CHAT_ID=
